// Dijkstra's shortest paths: a min-priority queue of (distance, vertex) pairs
f mn() {
    _ n, m: it.
    in @ n @ m.
    _ graph: vec<vec<pr<it, ll>>> = vec<vec<pr<it, ll>>>(n + 1).
    for (_ i: it = 0. i < m. ++i) {
        _ a, b: it.
        _ w: ll.
        in @ a @ b @ w.
        graph[a].pb(pr(b, w)).
        graph[b].pb(pr(a, w)).
    }

    _ infinity: ll = 1e18.
    _ distance: vec<ll> = vec<ll>(n + 1, infinity).
    _ queue: minpq<pr<ll, it>>.
    distance[1] = 0.
    queue.ps(pr(ll(0), 1)).
    wh !queue.emp() {
        _ current: pr<ll, it> = queue.tp().
        queue.pp().
        if current.f > distance[current.s] { cont. }
        for (edge in graph[current.s]) {
            _ next: ll = current.f + edge.s.
            if next < distance[edge.f] {
                distance[edge.f] = next.
                queue.ps(pr(next, edge.f)).
            }
        }
    }

    for (v in rng(1, n + 1)) {
        if distance[v] == infinity { ou @@ v @@ ": unreachable" @@ el. } else { ou @@ v @@ ": " @@ distance[v] @@ el. }
    }
}
