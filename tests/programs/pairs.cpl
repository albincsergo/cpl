// pairs: making them, their fields, comparing them, and using them as map keys
f mn() {
    _ p: pr<it, st> = pr(3, "abc").
    _ q: pr<ll, ll> = pr(1, 2).
    p.f += 10. q.s = q.f * 100.
    ou @@ p @@ " | " @@ q @@ " | " @@ p.first @@ p.second @@ el.
    ou @@ (pr(1, 2) < pr(1, 3)) @@ (pr(2, 0) < pr(1, 9)) @@ (pr(1, "b") == pr(1, "b")) @@ (q >= pr(1, 100)) @@ el.
    _ grid: map<pr<it, it>, it>.
    grid[pr(-1, 5)] = 7. grid[pr(0, 0)] = 1. grid[pr(-1, -5)] = 3. grid[pr(2, 1)] += 4.
    _ ks: vec<pr<it, it>> = grid.keys().
    ou @@ ks @@ " / " @@ grid[pr(-1, -5)] @@ ' ' @@ grid.has(pr(9, 9)) @@ el.
    _ v: vec<pr<ll, ch>>.
    v.pb(pr(5, 'x')). v.pb(pr(ll(1), 'z')).
    in @ q.
    ou @@ v[1].f @@ v[0].s @@ ' ' @@ q @@ el.
    _ nested: pr<pr<it, it>, bo> = pr(pr(1, 2), true).
    nested.f.s = 20.
    ou @@ nested @@ el.
}
